
{
  "entities": {
    "HealthcareService": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HealthcareService",
      "type": "object",
      "description": "Represents a healthcare service record for livestock.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Healthcare Service record."
        },
        "date": {
          "type": "string",
          "description": "Date when the service was provided.",
          "format": "date-time"
        },
        "puskeswan": {
          "type": "string",
          "description": "The name of the Puskeswan."
        },
        "officerName": {
          "type": "string",
          "description": "Name of the officer who provided the service."
        },
        "ownerName": {
          "type": "string",
          "description": "Name of the livestock owner."
        },
        "ownerAddress": {
          "type": "string",
          "description": "Address of the livestock owner."
        },
        "nik": {
          "type": "string",
          "description": "Owner's National Identity Number (NIK). Optional."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Owner's phone number. Optional."
        },
        "vaccinationProgram": {
            "type": "string",
            "description": "The vaccination program for the service. Optional."
        },
        "livestockType": {
          "type": "string",
          "description": "Type of livestock."
        },
        "livestockCount": {
          "type": "number",
          "description": "Number of livestock affected."
        },
        "treatments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "medicineType": {
                "type": "string"
              },
              "medicineName": {
                "type": "string"
              },
              "dosageValue": {
                "type": "number"
              },
              "dosageUnit": {
                "type": "string"
              }
            },
            "required": [
              "medicineType",
              "medicineName",
              "dosageValue",
              "dosageUnit"
            ]
          }
        }
      },
      "required": [
        "date",
        "puskeswan",
        "officerName",
        "ownerName",
        "ownerAddress",
        "livestockType",
        "livestockCount",
        "treatments"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "collections": {
      "/healthcareServices/{serviceId}": {
        "schema": {
          "$ref": "#/backend/entities/HealthcareService"
        },
        "description": "Stores all healthcare service records. Publicly readable and writable for this simple application."
      }
    }
  }
}
